meta {
  name: WarmUp2
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/book/{{bookId}}
  body: none
  auth: none
}

script:pre-request {
  const useRuntimeBookId = String(bru.getEnvVar("useRuntimeBookId") || "").toLowerCase() === "true";
  if (useRuntimeBookId) {
    bru.runner.skipRequest();
  }
}
