meta {
  name: DownloadBook
  type: http
  seq: 50
}

get {
  url: {{baseUrl}}/api/book/download2/{{bookId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains application/pdf
  res.headers["content-disposition"]: contains filename
  res.headers["content-length"]: isDefined
}
