meta {
  name: CreateBook
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api/book
  body: json
  auth: none
}

body:json {
  "Unicors strike back"
}

assert {
  res.status: eq 200
  res.body.BookId: isString
  res.body.BookId.length: eq 36
}

script:post-response {
  const useRuntimeBookId = String(bru.getEnvVar("useRuntimeBookId") || "").toLowerCase() === "true";

  if (useRuntimeBookId) {
    if (!res.body || !res.body.BookId) {
      throw new Error("CreateBook response does not contain BookId.");
    }

    bru.setVar("bookId", String(res.body.BookId));
    bru.setVar("statusPollAttempt", "0");
  }
}
