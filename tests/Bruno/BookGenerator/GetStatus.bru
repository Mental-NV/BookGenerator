meta {
  name: GetStatus
  type: http
  seq: 40
}

get {
  url: {{baseUrl}}/api/book/{{bookId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.BookTitle: isString
  res.body.Progress: isNumber
  res.body.ErrorMessage: isNull
}

script:post-response {
  const waitForCompletion = String(bru.getEnvVar("waitForCompletion") || "").toLowerCase() === "true";

  if (waitForCompletion) {
    const status = String(res.body?.Status || "");
    const normalizedStatus = status.toLowerCase();
    const errorMessage = res.body?.ErrorMessage;

    if (normalizedStatus === "failed" || normalizedStatus === "error" || (typeof errorMessage === "string" && errorMessage.trim().length > 0)) {
      throw new Error(`Book generation failed. Status=${status}, Error=${errorMessage}`);
    }

    if (normalizedStatus !== "completed") {
      const currentAttempt = Number(bru.getVar("statusPollAttempt") || "0");
      const nextAttempt = currentAttempt + 1;
      const maxPollAttempts = Number(bru.getEnvVar("maxPollAttempts") || "30");
      bru.setVar("statusPollAttempt", String(nextAttempt));
      if (nextAttempt <= maxPollAttempts) {
        bru.runner.setNextRequest("GetStatus");
      } else {
        console.warn(`Book generation did not reach Completed status within ${maxPollAttempts} polls. Last status=${status}. Continuing test flow.`);
      }
    } else {
      bru.setVar("statusPollAttempt", "0");
    }
  }
}
